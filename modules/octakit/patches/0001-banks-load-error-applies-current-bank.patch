A stock bank load that returns an error (a bank file the firmware cannot
parse or whose checksum fails: "Couldn't read bank file ..." in its LOG;
a missing one) returned from gk_stock_banks_load_work before the post
step, so the lifecycle word stayed QUIESCED for the rest of the session:
every pattern paste halted at gk_current_pattern_part_set_fatal and every
part apply was skipped (measured under the ColdFire port, 4 Oct 2026,
with a bank file from Sam's card whose checksum the unit had written
wrong). Stock itself continues with what it has.

Running the post step and the activation on the stock result (the first
version of this patch, two nops) activates and then halts in
gk_ui_transition_prepare_entry_release: stock's load loop applies the
current bank (SRAM working copy, pattern request, engine part load,
0x400907b8..0x400907ea) only when its file parsed, so after an error the
engine's bank/part bytes are the previous project's and her validator
returns CORRUPT at the engine-bank compare. octabam_banks_load_fixup.S
runs that apply when the engine's bytes disagree with the current
bank/part, then falls into the post step as before. Six bytes at the
site become one `jsr`, so her layout holds (the build checks every stock
slice inside the runtime at its recorded offset); the new unit is the
last source, after persistence.c, in a `.runtime.*` section, so it lands
after everything her recipe addresses.

diff -ruN '--exclude=.git' a/firmware.json b/firmware.json
--- a/firmware.json
+++ b/firmware.json
@@ -14031,7 +14031,8 @@
     "carried_pattern_ui_lag.S",
     "queue_commit_deferral.S",
     "pattern_kit_paste.S",
-    "persistence.c"
+    "persistence.c",
+    "octabam_banks_load_fixup.S"
   ],
   "interface_version": 1,
   "compiler": {
diff -ruN '--exclude=.git' a/octabam_banks_load_fixup.S b/octabam_banks_load_fixup.S
--- a/octabam_banks_load_fixup.S
+++ b/octabam_banks_load_fixup.S
@@ -0,0 +1,70 @@
+/*
+ * After a stock bank load that returned an error, apply the current bank
+ * the way stock's own load loop applies a bank that parsed
+ * (0x400907b8..0x400907ea: the SRAM working copy, the pattern request, the
+ * engine part load) -- the loop skips that apply for a bank whose file
+ * failed, so the engine's bank/part bytes (0x80001828/9) and the SRAM
+ * working bank stay the previous project's while 0x80000002/3 name the
+ * new one, and gk_ui_transition_prepare_entry_release returns CORRUPT at
+ * its engine-bank compare on the first activation.
+ *
+ * Called from gk_stock_banks_load_work in place of its
+ * `tst.l %d0 / bmi.s .Lgk_banks_load_return / move.l %d0,-(%sp)` (six
+ * bytes, her layout kept), with %d0 = the stock result; returns with %d0
+ * pushed the way that site left it, so the post step and the activation
+ * run on the stock result in every case and the stock result is what the
+ * caller sees.  The apply runs only when the engine's bytes disagree with
+ * the current bank/part, i.e. when stock skipped it.
+ *
+ * The engine part load goes through her trampoline: her wrapper at the
+ * stock entry accepts four stock callers in the quiesced state and this
+ * is a fifth.  The pattern request wrapper replays stock when no queue
+ * commit is prepared (none is during a load).
+ */
+        .include "abi.inc"
+        /* Copies a resident bank into the SRAM working bank; stock's bank
+           select (0x400622b2) and its load loop (0x400907c4) call it. */
+        .set    OB_STOCK_BANK_WORKING_COPY,0x4000faf0
+        .section .runtime.octabam,"ax"
+        .align  4
+        .global gk_octabam_banks_load_fixup
+        .type   gk_octabam_banks_load_fixup,@function
+gk_octabam_banks_load_fixup:
+        tst.l   %d0
+        bpl.s   .Lob_fixup_done
+        lea     -56(%sp),%sp
+        movem.l %d1-%d7/%a0-%a6,(%sp)
+        move.l  %d0,%d2
+        moveq   #0,%d3
+        move.b  GK_STOCK_CURRENT_BANK_MIRROR,%d3
+        moveq   #0,%d4
+        move.b  GK_STOCK_CURRENT_PART_MIRROR,%d4
+        moveq   #0,%d0
+        move.b  GK_STOCK_ENGINE_BANK,%d0
+        cmp.l   %d3,%d0
+        bne.s   .Lob_fixup_apply
+        moveq   #0,%d0
+        move.b  GK_STOCK_ENGINE_PART,%d0
+        cmp.l   %d4,%d0
+        beq.s   .Lob_fixup_restore
+.Lob_fixup_apply:
+        move.l  %d3,-(%sp)
+        jsr     OB_STOCK_BANK_WORKING_COPY
+        moveq   #0,%d0
+        move.b  GK_STOCK_CURRENT_PATTERN,%d0
+        move.l  %d0,-(%sp)
+        move.l  %d3,-(%sp)
+        jsr     GK_STOCK_PATTERN_SCHEDULE_REQUEST_ENTRY
+        move.l  %d4,-(%sp)
+        move.l  %d3,-(%sp)
+        jsr     gk_stock_engine_part_load_trampoline
+        lea     20(%sp),%sp
+.Lob_fixup_restore:
+        move.l  %d2,%d0
+        movem.l (%sp),%d1-%d7/%a0-%a6
+        lea     56(%sp),%sp
+.Lob_fixup_done:
+        move.l  (%sp)+,%a1
+        move.l  %d0,-(%sp)
+        jmp     (%a1)
+        .size   gk_octabam_banks_load_fixup,.-gk_octabam_banks_load_fixup
diff -ruN '--exclude=.git' a/project_lifecycle.S b/project_lifecycle.S
--- a/project_lifecycle.S
+++ b/project_lifecycle.S
@@ -625,9 +625,7 @@
         .incbin "stock/0165.bin", 12, 4
         bsr.w   gk_stock_banks_load_work_trampoline
         lea     16(%sp),%sp
-        tst.l   %d0
-        bmi.s   .Lgk_banks_load_return
-        move.l  %d0,-(%sp)
+        jsr     gk_octabam_banks_load_fixup
         move.l  4(%sp),%d0
         cmpi.l  #GK_STOCK_BANKS_LOAD_PROJECT_RETURN,%d0
         beq.s   .Lgk_banks_load_full_post
